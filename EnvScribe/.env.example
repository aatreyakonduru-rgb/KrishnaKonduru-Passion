# ---- LLM provider (default: watsonx). Switch with LLM_PROVIDER=watsonx|ollama ----
LLM_PROVIDER=watsonx
WATSONX_APIKEY=<ENTER WATSONX API KEY>
WATSONX_URL=<ENTER WATSONX ML URL>
WATSONX_PROJECT_ID=<ENTER WATSONX PROJECT ID>
WATSONX_MODEL_ID=<ENTER MODEL ID, e.g., meta-llama/llama-3-3-70b-instruct>
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_ID=<ENTER MODEL ID>

# ---- MCP servers ----
MCP_SERVER_NAMES=<ENTER MCP SERVER NAMES COMMA SEPARATED>
MCP_SERVER_URLS=<ENTER MCP SERVER URLs COMMA SEPARATED>
MCP_SERVER_TRANSPORT=streamable-http

# ---- A2A server ----
DEFAULT_HOST=0.0.0.0
DEFAULT_PORT=8080
DEFAULT_PUBLIC_HOST=<ENTER PUBLIC HOST IF NEEDED>

# ---- Web UI (single user). Keep on loopback unless you front it with your own auth ----
UI_HOST=127.0.0.1
UI_PORT=8090

# ---- Authentication (both false by default). If enabling, BOTH client_id and client_secret are required (missing either = silent failure) ----
ENABLE_CLIENT_AUTH=false
ENABLE_USER_AUTH=false
IBM_TENANT_ID=<ENTER TENANT ID>
IBM_INTROSPECT_URL=<ENTER INTROSPECT URL>

# ---- AgentOps (optional; install on demand) ----
ENABLE_AGENTOPS=false
AGENTOPS_APP_NAME=<ENTER APP NAME>
AGENTOPS_ENDPOINT=<ENTER ENDPOINT>

# ---- EnvScribe ----
ENVSCRIBE_TARGETS=targets.yaml

# ---- Service accounts discovered by name (values supplied by the environment's secrets, never committed) ----
# Bitbucket Cloud: BITBUCKET_URL, BITBUCKET_USERNAME, BITBUCKET_APP_PASSWORD
# Jira Cloud:      JIRA_URL, JIRA_EMAIL, JIRA_API_TOKEN
# Confluence:      CONFLUENCE_URL, CONFLUENCE_EMAIL, CONFLUENCE_API_TOKEN
# Artifactory:     ARTIFACTORY_URL, ARTIFACTORY_TOKEN
# Bamboo:          BAMBOO_URL, BAMBOO_TOKEN
# SonarQube:       SONAR_HOST_URL, SONAR_TOKEN
# Snowflake:       SNOWFLAKE_ACCOUNT, SNOWFLAKE_AUTHENTICATOR=oauth, SNOWFLAKE_TOKEN, SNOWFLAKE_ROLE, SNOWFLAKE_WAREHOUSE
#                  (externalbrowser SSO cannot work in a headless VM)
# Postgres catalog (metadata only), when a db_catalogs entry has engine: postgres. Use a read-only account.
# PGHOST, PGPORT, PGUSER, PGPASSWORD, PGDATABASE (standard libpq variables; psycopg reads them)
# Live cloud inventory uses your existing CLI logins (aws sso login, gcloud auth login, az login, kubectl context); nothing is stored here.
